# Gateway base URL. In dev the Vite proxy forwards /api -> VITE_GATEWAY_URL.
VITE_GATEWAY_URL=http://localhost:3000

# What the app calls. Keep as /api so the dev proxy (and prod reverse proxy) own routing.
VITE_API_BASE_URL=/api

# Keycloak OIDC (Auth Code + PKCE, public client)
VITE_OIDC_AUTHORITY=https://evently-keycloak.happymeadow-928c3627.centralindia.azurecontainerapps.io/realms/evently
VITE_OIDC_CLIENT_ID=evently-public-client
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
VITE_OIDC_SCOPE=openid profile email
