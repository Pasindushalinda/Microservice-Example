{
  "ConnectionStrings": {
    "Database": "",
    "Cache": "",
    "Queue": ""
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "account",
    "TokenValidationParameters": {
      "ValidIssuers": [ "https://evently-keycloak.proudplant-27493de7.centralindia.azurecontainerapps.io/realms/evently" ]
    },
    "MetadataAddress": "https://evently-keycloak.proudplant-27493de7.centralindia.azurecontainerapps.io/realms/evently/.well-known/openid-configuration",
    "RequireHttpsMetadata": false
  },
  "KeyCloak": {
    "HealthUrl": "https://evently-keycloak.proudplant-27493de7.centralindia.azurecontainerapps.io/health/"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://evently-seq" } }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "Evently.Api"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://evently-jaeger:4317"
}
